# Optional local configuration. Compose supplies its own service-DNS BANK_URL.
# Set these variables in the shell for `make run`; Compose also reads .env.
BANK_URL=http://localhost:8080
BANK_CONNECT_TIMEOUT=1
BANK_READ_TIMEOUT=2
BANK_WRITE_TIMEOUT=2
BANK_POOL_TIMEOUT=1
BANK_DEADLINE=3
LOG_LEVEL=INFO
